{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'phoneNumber', 'createdAt', 'updatedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "phoneNumber": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "preferences": {
          ".validate": "newData.hasChildren()",
          "theme": { ".validate": "newData.isString() && (newData.val() === 'system' || newData.val() === 'light' || newData.val() === 'dark')" },
          "language": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "$other": { ".validate": false }
        },
        "media": {
          ".validate": "newData.hasChildren()",
          "$mediaEntryId": {
            ".validate": "newData.hasChildren(['mediaType', 'externalSource', 'externalId', 'title', 'status', 'createdAt', 'updatedAt']) && (((newData.child('mediaType').val() === 'movie' || newData.child('mediaType').val() === 'series') && newData.child('externalSource').val() === 'tmdb' && (newData.child('status').val() === 'wantToWatch' || newData.child('status').val() === 'watching' || newData.child('status').val() === 'watched' || newData.child('status').val() === 'dropped')) || (newData.child('mediaType').val() === 'book' && newData.child('externalSource').val() === 'googleBooks' && (newData.child('status').val() === 'wantToRead' || newData.child('status').val() === 'reading' || newData.child('status').val() === 'completed' || newData.child('status').val() === 'dropped')))",
            "mediaType": { ".validate": "newData.isString() && (newData.val() === 'movie' || newData.val() === 'series' || newData.val() === 'book')" },
            "externalSource": { ".validate": "newData.isString() && (newData.val() === 'tmdb' || newData.val() === 'googleBooks')" },
            "externalId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "posterUrl": { ".validate": "newData.isString() && newData.val().length <= 2048" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "language": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "releaseDate": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "status": { ".validate": "newData.isString()" },
            "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 10000" },
            "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
